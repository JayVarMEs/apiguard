{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Normalise API spec (S0)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/normalize_api.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Normalise the file I am looking at",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/normalize_api.py",
      "args": ["${file}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "S0 contract tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tests/test_normalizer.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
